# Copy this file to .env and fill in real values

# Elasticsearch connection (the Elasticsearch URL, not Kibana)
ES_URL=https://elastic.yourcompany.local:9200
ES_USERNAME=dashboard_user
ES_PASSWORD=change_me
# Path to a company CA certificate inside the container, e.g. /app/certs/ca.crt
ES_CA_CERT=
# Set to false only for a quick test with a self-signed certificate
ES_VERIFY_CERTS=true

# Where the logs are and which fields to use (TODO: confirm from a sample log)
ES_INDEX=TODO-INDEX-*
SERVICE_FIELD=TODO_SERVICE_FIELD
TIMESTAMP_FIELD=@timestamp
ERROR_FIELD=isError

# "Today" starts at midnight in this time zone
TIMEZONE=Europe/Istanbul

# Page settings
TOP_N=15
DAILY_THRESHOLD=15
REFRESH_SECONDS=60
